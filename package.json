{
  "name": "fareql",
  "version": "0.1.3",
  "description": "Charge for GraphQL operations over MPP (HTTP 402), priced by what each operation selects. Plugins for GraphQL Yoga and Apollo Server, plus a wrapper for any Fetch handler.",
  "type": "module",
  "license": "MIT",
  "author": "Bruce0X (https://github.com/Bruce039)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bruce039/fareql.git"
  },
  "homepage": "https://github.com/Bruce039/fareql#readme",
  "bugs": {
    "url": "https://github.com/Bruce039/fareql/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yoga": {
      "types": "./dist/yoga.d.ts",
      "import": "./dist/yoga.js"
    },
    "./apollo": {
      "types": "./dist/apollo.d.ts",
      "import": "./dist/apollo.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mpp",
    "mppx",
    "graphql",
    "http-402",
    "payments",
    "tempo",
    "graphql-yoga",
    "apollo-server",
    "pay-per-query",
    "monetization"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@apollo/server": "^4.0.0 || ^5.0.0",
    "graphql": "^16.8.0 || ^17.0.0",
    "graphql-yoga": "^5.0.0 || ^6.0.0",
    "mppx": "^0.17.0"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    },
    "graphql-yoga": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/server-plugin-response-cache": "^5.0.0",
    "@graphql-yoga/plugin-apq": "^4.0.1",
    "@graphql-yoga/plugin-persisted-operations": "^4.0.1",
    "@graphql-yoga/plugin-response-cache": "^4.0.1",
    "@types/node": "^22.19.1",
    "graphql": "^16.15.0",
    "graphql-yoga": "^6.0.1",
    "mppx": "^0.17.1",
    "typescript": "^5.9.3",
    "viem": "^2.57.16",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "fareql": "^0.1.2"
  }
}
