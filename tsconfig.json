{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "fareql": ["./src/index.ts"],
      "fareql/*": ["./src/*.ts"]
    }
  },
  "include": ["src", "test", "examples"]
}
